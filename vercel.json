{
  "version": 2,
  "buildCommand": "npm install",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*\\.(svg|png|ico|css|js))",
      "dest": "public/$1"
    },
    {
      "src": "/card/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/barista",
      "dest": "server.js"
    },
    {
      "src": "/",
      "dest": "server.js"
    }
  ]
}